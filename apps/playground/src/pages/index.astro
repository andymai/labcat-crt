---
import '@labcat/crt/glow.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@labcat/crt playground</title>
    <meta name="color-scheme" content="dark" />
    <meta
      name="description"
      content="Interactive playground for @labcat/crt — tweak presets, layers, gamma, and halation, then copy the resulting markup."
    />
    <style is:global>
      :root {
        color-scheme: dark;
        background: #0d0d0d;
        color: #d5d5d5;
        --pg-bezel: #050505;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
      body {
        font-family:
          'Berkeley Mono', ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, Consolas,
          monospace;
      }
      crt-overlay {
        padding: var(--pg-overlay-padding, 4rem 6vw);
        box-sizing: border-box;
      }

      /* Per-preset vignettes: only the article matching the overlay's preset
         renders. Default-preset (no attribute) maps to pvm. */
      crt-overlay > article[data-preset] {
        display: none;
      }
      crt-overlay[preset='pvm'] > article[data-preset='pvm'],
      crt-overlay:not([preset]) > article[data-preset='pvm'],
      crt-overlay[preset='consumer'] > article[data-preset='consumer'],
      crt-overlay[preset='amber'] > article[data-preset='amber'],
      crt-overlay[preset='green'] > article[data-preset='green'],
      crt-overlay[preset='p4-white'] > article[data-preset='p4-white'] {
        display: block;
      }

      h1.crt-glow {
        font-size: 2.5rem;
        margin: 0 0 1rem;
        color: var(--crt-glow-color, #f0f0f0);
        letter-spacing: 0.02em;
      }
      h2.crt-glow {
        font-size: 1rem;
        margin: 1.5rem 0 0.5rem;
        color: var(--crt-glow-color, #f0f0f0);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0.85;
      }
      p,
      pre,
      .terminal {
        line-height: 1.65;
        max-width: 64ch;
        margin: 0.75rem 0;
      }
      code.crt-glow {
        display: inline-block;
        padding: 0 0.25em;
        background: var(--pg-code-bg, rgba(255, 255, 255, 0.06));
        color: var(--crt-glow-color, #f0f0f0);
      }
      pre.terminal {
        white-space: pre;
        background: var(--pg-code-bg, rgba(255, 255, 255, 0.04));
        padding: 1rem 1.25rem;
        color: var(--crt-glow-color, #f0f0f0);
        font-size: 0.95em;
        overflow-x: auto;
      }
      .meta-row {
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin: 0 0 1rem;
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      ul.feature-list {
        line-height: 1.9;
        padding-left: 1.25rem;
        margin: 1rem 0;
      }

      .signature {
        margin: 1rem 0 1.5rem;
        max-width: 720px;
      }
      .signature svg {
        display: block;
        width: 100%;
        height: auto;
      }

      /* Drop-zone: user drops an image, it persists across preset switches.
         Empty state shows the placeholder via ::before. */
      .drop-zone {
        margin: 1.5rem 0;
        max-width: 720px;
        min-height: 120px;
        border: 1px dashed color-mix(in srgb, currentColor 30%, transparent);
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1.5rem;
        box-sizing: border-box;
        position: relative;
        transition: border-color 160ms ease, background 160ms ease;
      }
      .drop-zone:empty::before {
        content: 'drop a photo here\A→ see it through any preset';
        white-space: pre;
        opacity: 0.55;
        font-size: 0.85rem;
        line-height: 1.6;
      }
      .drop-zone img {
        display: block;
        max-width: 100%;
        max-height: 360px;
        object-fit: contain;
      }
      .drop-zone[data-dragover='true'] {
        border-color: currentColor;
        background: color-mix(in srgb, currentColor 6%, transparent);
      }
      .drop-zone .remove-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        appearance: none;
        background: rgba(0, 0, 0, 0.55);
        color: inherit;
        border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
        font: inherit;
        font-size: 0.75rem;
        padding: 0.2rem 0.5rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <playground-app>
      <crt-overlay preset="pvm">
        <!-- ════════════════════════════════════════════════════════════════
             PVM — Sony broadcast monitor. SMPTE 75% color bars + timecode.
             ════════════════════════════════════════════════════════════════ -->
        <article data-preset="pvm">
          <div class="meta-row">
            <span>TC: 01:23:45:12</span>
            <span>VID-A · NTSC 480i</span>
            <span>BVM-D24</span>
          </div>
          <h1 class="crt-glow">broadcast monitoring</h1>
          <div class="signature" aria-label="SMPTE 75% color bars">
            <svg viewBox="0 0 700 400" xmlns="http://www.w3.org/2000/svg">
              <!-- Top: SMPTE 75% bars, 7 columns, 67% height -->
              <g>
                <rect x="0" y="0" width="100" height="270" fill="#c0c0c0" />
                <rect x="100" y="0" width="100" height="270" fill="#c0c000" />
                <rect x="200" y="0" width="100" height="270" fill="#00c0c0" />
                <rect x="300" y="0" width="100" height="270" fill="#00c000" />
                <rect x="400" y="0" width="100" height="270" fill="#c000c0" />
                <rect x="500" y="0" width="100" height="270" fill="#c00000" />
                <rect x="600" y="0" width="100" height="270" fill="#0000c0" />
              </g>
              <!-- Reverse blue castellation row -->
              <g>
                <rect x="0" y="270" width="100" height="40" fill="#0000c0" />
                <rect x="100" y="270" width="100" height="40" fill="#0a0a0a" />
                <rect x="200" y="270" width="100" height="40" fill="#c000c0" />
                <rect x="300" y="270" width="100" height="40" fill="#0a0a0a" />
                <rect x="400" y="270" width="100" height="40" fill="#00c0c0" />
                <rect x="500" y="270" width="100" height="40" fill="#0a0a0a" />
                <rect x="600" y="270" width="100" height="40" fill="#c0c0c0" />
              </g>
              <!-- PLUGE: superblack, black, suprablack -->
              <g>
                <rect x="0" y="310" width="140" height="90" fill="#000c33" />
                <rect x="140" y="310" width="120" height="90" fill="#ffffff" />
                <rect x="260" y="310" width="170" height="90" fill="#1f1264" />
                <rect x="430" y="310" width="50" height="90" fill="#070707" />
                <rect x="480" y="310" width="50" height="90" fill="#0a0a0a" />
                <rect x="530" y="310" width="50" height="90" fill="#0e0e0e" />
                <rect x="580" y="310" width="120" height="90" fill="#070707" />
              </g>
            </svg>
          </div>
          <p>
            Calibrated <code class="crt-glow">BVM</code> on the line cut, scopes pinned to 100 IRE.
            The aperture grille is fine enough that text edges hold up under colorist scrutiny —
            that's the brief.
          </p>
          <ul class="feature-list">
            <li>480 NTSC scanlines · 480 horizontal RGB triads</li>
            <li>No chromatic aberration · near-flat vignette</li>
            <li>Halation tuned for graphics overlays</li>
          </ul>
          <div class="drop-zone"></div>
        </article>

        <!-- ════════════════════════════════════════════════════════════════
             CONSUMER — NTSC home TV. Monoscope-style test pattern.
             ════════════════════════════════════════════════════════════════ -->
        <article data-preset="consumer">
          <div class="meta-row">
            <span>CH 4 · WMHP</span>
            <span>525/60 NTSC</span>
            <span>1985-09-23 · 03:14:00</span>
          </div>
          <h1 class="crt-glow">we'll return after these messages</h1>
          <div class="signature" aria-label="monoscope test pattern">
            <svg viewBox="0 0 600 450" xmlns="http://www.w3.org/2000/svg">
              <rect x="0" y="0" width="600" height="450" fill="#1a1a1a" />
              <!-- Crosshatch grid -->
              <g stroke="#9aa0a0" stroke-width="1" fill="none" opacity="0.55">
                <path d="M 0 75 L 600 75 M 0 150 L 600 150 M 0 225 L 600 225 M 0 300 L 600 300 M 0 375 L 600 375" />
                <path d="M 75 0 L 75 450 M 150 0 L 150 450 M 225 0 L 225 450 M 300 0 L 300 450 M 375 0 L 375 450 M 450 0 L 450 450 M 525 0 L 525 450" />
              </g>
              <!-- Center convergence circle -->
              <circle cx="300" cy="225" r="160" stroke="#e8e8e8" stroke-width="2" fill="none" />
              <circle cx="300" cy="225" r="80" stroke="#e8e8e8" stroke-width="1.5" fill="none" />
              <!-- Corner gradient bars (gray ramp) -->
              <g>
                <rect x="40" y="40" width="120" height="20" fill="#202020" />
                <rect x="40" y="60" width="120" height="20" fill="#444" />
                <rect x="40" y="80" width="120" height="20" fill="#777" />
                <rect x="40" y="100" width="120" height="20" fill="#aaa" />
                <rect x="40" y="120" width="120" height="20" fill="#e0e0e0" />
              </g>
              <!-- Resolution wedges right side -->
              <g stroke="#e8e8e8" stroke-width="1.2" fill="none">
                <path d="M 480 60 L 555 80 M 480 75 L 555 80 M 480 90 L 555 80" />
                <path d="M 480 100 L 555 120 M 480 110 L 555 120 M 480 120 L 555 120 M 480 130 L 555 120 M 480 140 L 555 120" />
              </g>
              <!-- Centered station ID -->
              <text x="300" y="232" text-anchor="middle" fill="#f0f0f0" font-family="monospace" font-size="22" font-weight="600">CH 4</text>
              <!-- Color sample dots -->
              <g>
                <circle cx="100" cy="380" r="15" fill="#c00000" />
                <circle cx="150" cy="380" r="15" fill="#00c000" />
                <circle cx="200" cy="380" r="15" fill="#0000c0" />
                <circle cx="400" cy="380" r="15" fill="#c0c000" />
                <circle cx="450" cy="380" r="15" fill="#c000c0" />
                <circle cx="500" cy="380" r="15" fill="#00c0c0" />
              </g>
            </svg>
          </div>
          <p>
            A late-late spot break on the local affiliate. Shadow-mask grain, mistracked VHS color,
            the faint hum of a hot tube. <code class="crt-glow">--crt-aberration-x</code> bumped up
            just enough to read as "consumer receiver" not "studio reference."
          </p>
          <ul class="feature-list">
            <li>320 horizontal triads · coarser shadow mask</li>
            <li>Phosphor shimmer animation (60Hz cheat)</li>
            <li>Sub-pixel chromatic aberration</li>
          </ul>
          <div class="drop-zone"></div>
        </article>

        <!-- ════════════════════════════════════════════════════════════════
             AMBER — VT220 terminal. Oscilloscope trace + login prompt.
             ════════════════════════════════════════════════════════════════ -->
        <article data-preset="amber">
          <div class="meta-row">
            <span>tty/0 · 9600 8N1</span>
            <span>VT220 emulation</span>
            <span>UP 47d 03:14</span>
          </div>
          <h1 class="crt-glow">amber phosphor, slow mail</h1>
          <div class="signature" aria-label="oscilloscope sine trace">
            <svg viewBox="0 0 600 220" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" fill="none">
              <!-- Grid background -->
              <g stroke="currentColor" stroke-width="0.5" opacity="0.25">
                <path d="M 0 55 L 600 55 M 0 110 L 600 110 M 0 165 L 600 165" />
                <path d="M 75 0 L 75 220 M 150 0 L 150 220 M 225 0 L 225 220 M 300 0 L 300 220 M 375 0 L 375 220 M 450 0 L 450 220 M 525 0 L 525 220" />
              </g>
              <!-- Center line -->
              <path d="M 0 110 L 600 110" stroke-width="0.8" opacity="0.6" />
              <!-- Main sine trace -->
              <path
                d="M 0 110 Q 37 30 75 110 T 150 110 T 225 110 T 300 110 T 375 110 T 450 110 T 525 110 T 600 110"
                stroke-width="2"
                stroke-linecap="round"
              />
              <!-- Secondary trace (offset, half amplitude) -->
              <path
                d="M 0 110 Q 37 70 75 110 T 150 110 T 225 110 T 300 110 T 375 110 T 450 110 T 525 110 T 600 110"
                stroke-width="1.2"
                stroke-linecap="round"
                opacity="0.55"
              />
              <!-- Lissajous figure-8 inset, top-right -->
              <path
                d="M 510 30 q 20 -15 30 0 q 10 15 -10 20 q -20 -5 -10 -20 q 10 -15 30 0"
                stroke-width="1.5"
                opacity="0.7"
              />
            </svg>
          </div>
          <pre class="terminal">amber@vt220.lab $ uptime
14:23:01  up 47 days,  3:14,  load 0.04 0.02 0.01

amber@vt220.lab $ tail -3 /var/spool/mail/andy
From: ops@labcat.net
Date: Wed, 12 Nov 2025 14:21:33 -0500
Subject: replenish solder, ETA 14d

amber@vt220.lab $ █</pre>
          <p>
            Single-phosphor warmth — no shadow mask, no convergence error, just a 400-line raster
            and a glow that hangs in the room for a moment after each character draws.
          </p>
          <div class="drop-zone"></div>
        </article>

        <!-- ════════════════════════════════════════════════════════════════
             GREEN — IBM 5151 / DOS. ANSI box-drawn banner + dir listing.
             ════════════════════════════════════════════════════════════════ -->
        <article data-preset="green">
          <div class="meta-row">
            <span>COM1: 2400-N-8-1</span>
            <span>IBM 5151 · MDA</span>
            <span>DOS 3.30</span>
          </div>
          <h1 class="crt-glow">labcat // bbs</h1>
          <pre class="terminal crt-glow" style="font-size: 0.9em; line-height: 1.2">╔══════════════════════════════════════════════════════╗
║  L A B C A T   B U L L E T I N   S Y S T E M   v3   ║
║  ──────────────────────────────────────────────────  ║
║   1  ▸  File areas        4  ▸  Door games           ║
║   2  ▸  Message bases     5  ▸  Sysop chat           ║
║   3  ▸  Local users       6  ▸  Goodbye              ║
╚══════════════════════════════════════════════════════╝
Selection: _</pre>
          <pre class="terminal">C:\&gt; dir /w
 Volume in drive C is LABCAT-VOL1

 AUTOEXEC BAT   142    COMMAND  COM 37557
 CONFIG   SYS    87    DOS       &lt;DIR&gt;
 LABCAT   EXE 12842    README   TXT  3104
 SCANDISK LOG   612    UTILS     &lt;DIR&gt;

         8 file(s)      54486 bytes
         2 dir(s)   12,582,912 bytes free

C:\&gt; _</pre>
          <p>
            P31 green phosphor, 350-line text mode, no half-tones, no aliasing — characters either
            lit or they're not. The kind of clarity that puts an LCD to shame at 80×25.
          </p>
          <div class="drop-zone"></div>
        </article>

        <!-- ════════════════════════════════════════════════════════════════
             P4-WHITE — Apple Lisa / early Mac. Dithered welcome + window chrome.
             ════════════════════════════════════════════════════════════════ -->
        <article data-preset="p4-white">
          <div class="meta-row">
            <span>System 1.0</span>
            <span>720 × 364 · 1-bit</span>
            <span>QuickDraw</span>
          </div>
          <h1 class="crt-glow">welcome to lisawrite</h1>
          <div class="signature" aria-label="Lisa-style window chrome">
            <svg viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg" font-family="monospace">
              <!-- Outer window frame (Lisa stripe header) -->
              <rect x="20" y="20" width="560" height="280" fill="#fafafa" stroke="#1a1a1a" stroke-width="2" />
              <!-- Title bar with horizontal stripes -->
              <g>
                <rect x="20" y="20" width="560" height="26" fill="#fafafa" stroke="#1a1a1a" stroke-width="2" />
                <g stroke="#1a1a1a" stroke-width="1">
                  <path d="M 22 24 L 578 24 M 22 28 L 578 28 M 22 32 L 578 32 M 22 36 L 578 36 M 22 40 L 578 40" />
                </g>
                <rect x="220" y="22" width="160" height="22" fill="#fafafa" />
                <text x="300" y="38" text-anchor="middle" fill="#1a1a1a" font-size="13">Q1.report</text>
                <!-- Close box -->
                <rect x="30" y="26" width="14" height="14" fill="#fafafa" stroke="#1a1a1a" stroke-width="1.5" />
              </g>
              <!-- Body content -->
              <g fill="#1a1a1a" font-size="13">
                <text x="40" y="80">Tonight, finalize fab specs</text>
                <text x="40" y="100">for the labcat prototype.</text>
                <text x="40" y="135">Tasks ▸</text>
                <text x="60" y="155">☐ etch silkscreen</text>
                <text x="60" y="175">☐ pour solder paste</text>
                <text x="60" y="195">☑ verify pinout</text>
                <text x="60" y="215">☐ smoke test</text>
              </g>
              <!-- Sidebar with smiley Mac icon -->
              <g transform="translate(450, 70)">
                <rect x="0" y="0" width="90" height="70" fill="#fafafa" stroke="#1a1a1a" stroke-width="2" />
                <!-- screen area -->
                <rect x="8" y="8" width="74" height="42" fill="#1a1a1a" />
                <!-- smiley -->
                <circle cx="32" cy="24" r="2" fill="#fafafa" />
                <circle cx="58" cy="24" r="2" fill="#fafafa" />
                <path d="M 30 36 Q 45 44 60 36" stroke="#fafafa" stroke-width="2" fill="none" />
                <!-- base -->
                <rect x="36" y="50" width="18" height="6" fill="#fafafa" stroke="#1a1a1a" stroke-width="1.5" />
                <rect x="20" y="56" width="50" height="6" fill="#fafafa" stroke="#1a1a1a" stroke-width="1.5" />
                <text x="45" y="84" text-anchor="middle" fill="#1a1a1a" font-size="11">Lisa</text>
              </g>
              <!-- Dither pattern in lower-right (1-bit shading) -->
              <pattern id="dither-50" width="2" height="2" patternUnits="userSpaceOnUse">
                <rect width="1" height="1" fill="#1a1a1a" />
                <rect x="1" y="1" width="1" height="1" fill="#1a1a1a" />
              </pattern>
              <rect x="380" y="220" width="180" height="60" fill="url(#dither-50)" />
              <rect x="380" y="220" width="180" height="60" fill="none" stroke="#1a1a1a" stroke-width="1.5" />
              <text x="470" y="256" text-anchor="middle" fill="#fafafa" font-size="12" font-weight="600">50% gray</text>
            </svg>
          </div>
          <p>
            Apple Lisa, 1983. White P4 phosphor, 364-line bitmap, every shade of gray faked with
            ordered dithering. The screen that put a graphical interface on a desk and never
            quite became a sensation — but every Mac that followed inherited the look.
          </p>
          <div class="drop-zone"></div>
        </article>
      </crt-overlay>
    </playground-app>

    <script>
      import '@labcat/crt';
      import '../components/playground-app.ts';
    </script>
  </body>
</html>
