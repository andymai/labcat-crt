---
import '@labcat/crt/glow.css';

interface Props {
  title: string;
  preset: 'pvm' | 'consumer' | 'amber' | 'green' | 'p4-white';
}

const { title, preset } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — @labcat/crt demo</title>
    <style>
      :root {
        color-scheme: dark;
        background: #0d0d0d;
        color: #d5d5d5;
        font-family:
          'Berkeley Mono', ui-monospace, 'JetBrains Mono', SFMono-Regular,
          Menlo, Consolas, monospace;
      }
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
      crt-overlay {
        display: block;
        min-height: 100vh;
        padding: 4rem 6vw;
        box-sizing: border-box;
      }
      h1.crt-glow {
        font-size: 2.5rem;
        margin: 0 0 1.5rem;
        color: var(--crt-glow-color, #f0f0f0);
      }
      p {
        line-height: 1.65;
        max-width: 60ch;
      }
      code.crt-glow {
        display: inline-block;
        padding: 0 0.25em;
        background: rgba(255, 255, 255, 0.06);
        color: var(--crt-glow-color, #f0f0f0);
      }
      ul {
        line-height: 1.8;
      }
      .reference-svg {
        margin-top: 2rem;
        color: var(--crt-glow-color, #4a90e2);
      }
      .preset-label {
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
      }
    </style>
  </head>
  <body>
    <crt-overlay preset={preset}>
      <div class="preset-label">preset = {preset}</div>
      <h1 class="crt-glow">{title}</h1>
      <p>
        Reference content for visual snapshot tests. Identical across all four
        preset routes so the only delta in the rendered output is the CRT effect
        itself. Tag bright elements with <code class="crt-glow">class="crt-glow"</code>
        to opt them into halation.
      </p>
      <p>
        The aperture grille shows on color presets only; monochrome amber and
        green tubes had a single phosphor type, so the grille variable resolves
        to <code class="crt-glow">none</code> for those.
      </p>
      <ul>
        <li>Static scanlines with a Gaussian beam profile</li>
        <li>Phosphor noise (turbulence SVG, ~3% alpha)</li>
        <li>Vignette + sub-pixel corner chromatic fringe</li>
        <li>Halation on the <code class="crt-glow">.crt-glow</code> class</li>
      </ul>
      <svg
        class="reference-svg"
        width="120"
        height="60"
        viewBox="0 0 120 60"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="oscilloscope trace"
      >
        <path
          d="M 0 30 Q 15 5, 30 30 T 60 30 T 90 30 T 120 30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
    </crt-overlay>
    <script>
      import '@labcat/crt';
    </script>
  </body>
</html>
