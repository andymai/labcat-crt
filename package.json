{
  "name": "@labcat/crt-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Customizable CRT visualization library for the web",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --filter=@labcat/crt",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cem": "turbo run cem",
    "size": "turbo run size",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "size-limit": "^14.2.0",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  }
}
